# CP進捗通知 — 環境変数のテンプレート
# このファイルをコピーして .env を作る。値は絶対にここへ書かない。
#   cp .env.example .env
# 形式は KEY=VALUE（= の前後に空白を入れない）

# ---------------------------------------------------------------------------
# CAREER PLUS API
# ---------------------------------------------------------------------------
# CP の管理画面で発行した読み取り専用のAPIキー
# 作成・更新・削除の権限は付与しないこと（docs/design/05-apikey-request.md）
CP_NOTIFY_API_KEY=

# ---------------------------------------------------------------------------
# Slack Incoming Webhook（チャンネルごとに1本）
# ---------------------------------------------------------------------------
# 要件1: 求職者項目のステータス変化
SLACK_WEBHOOK_CAREER_STATUS=
# 要件2: 進捗フローの進行
SLACK_WEBHOOK_PROGRESS_FLOW=
# 要件3: 求人紹介OK（要件2と同じウォッチャーが送るが通知先は別）
SLACK_WEBHOOK_JOB_INTRO=
# 運用アラート（カーソル遅延・連続失敗・dead_letter）
SLACK_WEBHOOK_OPS=

# ---------------------------------------------------------------------------
# メール送信（要件4）
# PoC はローカルSMTP（Mailpit / 127.0.0.1:1025）。認証しないため設定不要。
# 接続先は config/app.yaml の notifiers.mail に書く。
#
# 本番の経路（仕様書 8.4 / 付録C）
#   SMTP リレー + IP許可 : 認証なし。ここに書く変数はない
#   Gmail API + OAuth2   : 下の3つを設定する
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
